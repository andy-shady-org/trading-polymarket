{
  "_comment": "Stage-1 paper pilot (docs/GO-NO-GO.md, docs/PAPER-TRADING.md). Copy to configs/paper.json, then: trading-core run --config configs/paper.json. Amounts are USDC. Positions are held to resolution (exits off, close_positions_on_shutdown false); the module redeems them at 1 or 0. Keep bankroll equal to paper_starting_balance so lane sizing matches the account.",
  "module": "polymarket",
  "mode": "paper",
  "strategy_name": "polymarket",
  "order_size": 10,
  "paper_starting_balance": 1000,
  "cycle_seconds": 60,
  "max_signals_per_cycle": 5,
  "risk": {
    "max_total_exposure": 300,
    "max_position_size": 25,
    "max_active_positions": 40,
    "max_concentration_pct": 0.1,
    "max_loss_per_trade": 0,
    "reserve_balance": 100
  },
  "breaker": {
    "max_daily_drawdown_pct": 0.1,
    "emergency_hard_lock_hours": 24,
    "drawdown_reference_mode": "adaptive_ratchet",
    "profit_ratchet_ratio": 0.5,
    "profit_ratchet_min_gain_pct": 0.02,
    "profit_drawdown_tolerance_pct": 0.35,
    "max_cumulative_drawdown_pct": 0.25
  },
  "exits": {},
  "close_positions_on_shutdown": false,
  "module_settings": {
    "bankroll": 1000,
    "heartbeat_seconds": 60,
    "weather": {
      "enabled": true,
      "lead_days": 0,
      "min_local_hour": 15,
      "min_edge": 0.06,
      "market_weight": 0.5,
      "max_edge": 0.25,
      "max_notional": 15,
      "max_positions_per_day": 3,
      "today_error_weight": 0.5,
      "intraday_sigma": 0.8,
      "bias_path": "data/weather_bias.json"
    },
    "favourite": {
      "enabled": false,
      "calibration_path": "data/calibration.json"
    },
    "momentum": {
      "enabled": false
    },
    "fed": {
      "enabled": false
    },
    "crossvenue": {
      "enabled": false,
      "pairs_path": "data/pairs.json"
    }
  },
  "health_timeout_seconds": 600,
  "degradation_alert_minutes": 15,
  "daily_summary_hour_utc": 8,
  "status_path": "data/paper/status.json",
  "audit_log_path": "data/paper/audit.jsonl",
  "event_log_path": "data/paper/events.jsonl",
  "log_file": "data/paper/trading-core.log"
}
